<a class="lui-button-$paramButtonColor aui-button" href="/pages/createpage-entervariables.action?templateId=$paramTemplateID&spaceKey=$theSpaceKey&title=$theNewTitle&newSpaceKey=$theSpaceKey&fromPageId=$theParentPage.id">$paramButtonText</a>
